	  Auto-update feed for this fork. The appcast lives in this repository and is
	  served straight from raw.githubusercontent.com, so no GitHub Pages setup is
	  needed. Sparkle verifies every update against the EdDSA public key below;
	  Apple code signing is not required for updates to be accepted.
	-->
	<key>SUFeedURL</key>
	<string>https://raw.githubusercontent.com/huo241/notch-lyrics/main/updater/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>h+Rvg7JIEhxgWooBXufc3GLZQTLlGex/hW6fGPB3C10=</string>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict/>
	</array>
</dict>
</plist>
