        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两个「匹配」选项跟随系统;自定义只用于精确对齐。"
          }
        }
      }
    },
    "The weather card: location, display and current data." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
