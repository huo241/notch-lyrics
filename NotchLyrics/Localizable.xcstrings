    "Infers your location from your network exit point, with no permissions needed. If you use a proxy or the result lands in a nearby city, turn it off and search for your city.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deduce tu ubicación a partir de la salida de red, sin permisos. Si usas un proxy o el resultado cae en otra ciudad, desactívalo y busca la tuya."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按网络出口推断位置，不需要任何权限。走代理或结果偏到邻近城市时，关掉它并搜索你要的城市。"
          }
        }
      }
    },
