    "A temporary file shelf in the notch, plus the system service used to share files.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una bandeja temporal de archivos en el notch y el servicio del sistema para compartir archivos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刘海里的临时文件架，以及分享文件时使用的系统服务。"
