    "“Match real notch height” and “Match menubar height” follow the system; use a custom height only when you need exact alignment.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Igualar la altura real del notch» y «Igualar la altura de la barra de menús» siguen el sistema; usa una altura personalizada solo si necesitas un ajuste exacto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「匹配真实刘海高度」「匹配菜单栏高度」会跟随系统；自定义高度只在需要精确对齐时使用。"
          }
        }
      }
    },
    "“Now Playing” was the only option in previous versions and works with every media app.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Ahora suena» era la única opción en versiones anteriores y funciona con todas las apps multimedia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「正在播放」是旧版本唯一的选项，且兼容所有媒体应用。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
