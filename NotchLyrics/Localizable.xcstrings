    "Quick notes are saved as .md files in the folder you pick — the vault root or any folder inside it. You can also create a new folder here.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notas rápidas se guardan como archivos .md en la carpeta que elijas: la raíz del vault o cualquier carpeta dentro. También puedes crear una carpeta nueva aquí."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "速记会存成 .md 文件写进你选的文件夹。vault 根目录或其中任意文件夹都可以，需要新建文件夹也可以在这里建。"
          }
        }
      }
    },
    "Quick notes are saved as a new .md file in the selected folder, named after the first line.": {
      "extractionState": "manual",
