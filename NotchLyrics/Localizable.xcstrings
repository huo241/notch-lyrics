          }
        }
      }
    },
    "The background follows the weather and time of day; animating it costs the most battery." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El fondo sigue el tiempo y la hora; animarlo es lo que más batería consume."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景跟随天气与时段变化;开启动画最费电。"
          }
        }
      }
    },
    "The battery indicator and power alerts." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
